---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { getPublishedWorks, url, type Work } from '../../../lib/works';

export async function getStaticPaths() {
  const works = await getPublishedWorks();
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props as { work: Work };
const d = work.data;
const { Content } = await render(work);
const hasBody = Boolean(work.body?.replace(/<!--[\s\S]*?-->/g, '').trim());
const facts = [
  ['制作時期', d.date],
  ['担当', d.role],
  ['カテゴリ', d.category],
].filter(([, v]) => v) as [string, string][];
---
<Base title={d.title} description={d.summary} current="works">
  <article class="wrap page">
    <nav class="crumbs label" aria-label="パンくず">
      <a href={url()}>HOME</a> <span aria-hidden="true">/</span> <a href={url('works/')}>WORKS</a> <span aria-hidden="true">/</span> <span aria-current="page">{d.title}</span>
    </nav>
    <header class="head">
      <p class="label cat">{d.category}</p>
      <h1>{d.title}</h1>
      <p class="jp summary">{d.summary}</p>
    </header>

    <figure class="cover"><img src={url(d.cover)} alt={d.alt} /></figure>

    <div class="cols">
      <dl class="facts">
        {facts.map(([k, v]) => (<div><dt class="jp">{k}</dt><dd class="jp">{v}</dd></div>))}
        {d.technologies?.length ? (<div><dt class="jp">使用技術</dt><dd><ul class="tech">{d.technologies.map((t) => <li>{t}</li>)}</ul></dd></div>) : null}
        {d.links?.length ? (
          <div><dt class="jp">関連リンク</dt><dd><ul class="links">{d.links.map((l) => <li><a href={l.url} rel="noopener">{l.label} ↗<span class="visually-hidden">（外部サイト）</span></a></li>)}</ul></dd></div>
        ) : null}
      </dl>
      {hasBody && <div class="body jp"><Content /></div>}
    </div>

    {d.gallery?.length ? (
      <section class="gallery" aria-label="追加画像">
        {d.gallery.map((g) => <figure><img src={url(g.src)} alt={g.alt} loading="lazy" /></figure>)}
      </section>
    ) : null}

    <nav class="back label" aria-label="戻る">
      <a href={url('works/')}>← ALL WORKS</a>
      <a href={url()}>← HOME</a>
    </nav>
  </article>
</Base>

<style>
  .page { padding-top: 45px; }
  .crumbs { font-size: .875rem; display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .head { padding: 40px 0 32px; display: flex; flex-direction: column; gap: 12px; }
  .head p { margin: 0; }
  .cat { font-size: .875rem; }
  h1 { font: 700 clamp(2.5rem, 6vw, 4.5rem)/1.15 var(--f-mono); margin: 0; overflow-wrap: anywhere; }
  .summary { font-size: 1.125rem; }
  .cover { margin: 0; background: var(--c-blue); padding: clamp(16px, 4vw, 48px); }
  .cover img { margin: 0 auto; max-height: 70vh; object-fit: contain; }
  .cols { display: grid; grid-template-columns: minmax(200px, 320px) 1fr; gap: 48px; padding-top: 48px; }
  .facts { margin: 0; display: flex; flex-direction: column; gap: 20px; }
  dt { font-size: .875rem; opacity: .85; }
  dd { margin: 4px 0 0; font-weight: 700; }
  .tech, .links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .body { font-size: 1.0625rem; line-height: 1.95; max-width: 42em; }
  .body :global(p) { margin: 0 0 1.2em; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 24px; padding-top: 48px; }
  .gallery figure { margin: 0; background: var(--c-blue); padding: 16px; }
  .back { display: flex; gap: 32px; padding-top: 64px; flex-wrap: wrap; }
  .back a { text-decoration: none; }
  .back a:hover { text-decoration: underline; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; gap: 32px; } }
</style>
