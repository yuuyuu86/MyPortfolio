---
import Base from '../layouts/Base.astro';
import BuildIntro from '../components/BuildIntro.astro';
import { getPublishedWorks, getFeaturedWorks, url } from '../lib/works';
import { site } from '../data/site';

const all = await getPublishedWorks();
const featured = await getFeaturedWorks();
const pad = (n: number) => String(n).padStart(2, '0');
const heroWorks = ['marugoto-fes', 'paperbrowser', 'tokarium'].map((id) => all.find((w) => w.id === id)).filter((w): w is NonNullable<typeof w> => Boolean(w));
const first = heroWorks[0] ?? all[0];
// ヒーローのプレビューは公開作品すべてからランダムに切り替える
const pool = all.map((w, i) => ({ id: w.id, no: pad(i + 1), title: w.data.title, cat: w.data.category, img: url(w.id === 'marugoto-fes' ? '/images/works/marugoto-fes/screen-01.webp' : w.data.cover), href: url(`works/${w.id}/`) }));
const firstNo = pad(all.findIndex((w) => w.id === first?.id) + 1);
const { email, github, x, xName } = site.contact;
const hasContact = Boolean(email || github || x);
const asciiLogo = String.raw` __   __  _   _  _____   _
 \ \ / / | | | ||_   _| / \
  \ V /  | | | |  | |  / _ \
   | |   | |_| |  | | / ___ \
   |_|    \___/   |_|/_/   \_\ `;
const terrain = Array.from({length: 18}, (_, y) => Array.from({length: 100}, (_, x) => {
 const r = 7 + Math.sin(x / 11) * 3 + Math.cos(x / 23) * 3;
 return Math.abs(y-r)<.55 ? '_' : y>r ? (x+y*3)%12===0 ? '/' : (x-y*3+120)%12===0 ? ':' : y%4===0 ? '.' : ' ' : ' ';
}).join('')).join('\n');
---
<Base intro current="home">
  <section class="hero wrap" aria-labelledby="hero-title">
    <pre class="ascii-terrain" aria-hidden="true">{terrain}</pre>
    <div class="hero-text" data-build="2">
      <p class="label terminal-line">[ YUTA / independent creator ]</p><pre class="ascii-logo" aria-hidden="true">{asciiLogo}</pre>
      <h1 id="hero-title" class="jp" data-type><span>アプリとゲームを、</span><span>使えるかたちに</span></h1>
      <p class="jp lead">デザインと開発を行き来しながら、<br />人や暮らしに届く体験をつくっています。</p>
      <div class="hero-actions jp"><a class="primary-link" href={url('works/')}>作品を見る <span aria-hidden="true">↗</span></a><a href={url('#about')}>私について</a></div>
    </div>

    {first && (
      <figure class="preview" data-current={first.id} data-view="ascii" data-build="3" data-draw aria-label="作品プレビュー">
        <script type="application/json" id="preview-pool" set:html={JSON.stringify(pool)} />
        <div class="ascii-toolbar"><span aria-hidden="true">+-- project.render --+</span><button type="button" class="view-toggle" aria-pressed="true">実画面に切り替え</button></div><div class="preview-head">
          <span class="label jp">作品プレビュー <span class="mono" data-p="num">{firstNo}</span></span>
          <div class="preview-tabs" role="group" aria-label="プレビューの操作">
            {heroWorks.length > 1 && heroWorks.map((w, i) => (
              <button type="button" data-select={w.id} aria-pressed={w.id === first.id ? 'true' : 'false'} aria-label={`${w.data.title} をプレビュー`}>{w.data.title.replace('まるごと祭公式アプリ2026', 'まるごと祭アプリ')}</button>
            ))}
            {pool.length > 1 && (
              <button type="button" class="preview-pause" aria-pressed="true" aria-label="自動切り替えを再開">再生</button>
            )}
          </div>
        </div>
        <div class="ascii-output" aria-hidden="true"><pre data-ascii></pre><noscript><img src={url(first.data.cover)} alt={first.data.alt} /></noscript></div><a class="preview-img" href={url(`works/${first.id}/`)} data-p="link" tabindex="-1" aria-hidden="true">
          <img class="companion" src={url('/images/works/marugoto-fes/screen-02.webp')} alt="" width="1206" height="2622" />
          <img src={url(first.id === 'marugoto-fes' ? '/images/works/marugoto-fes/screen-01.webp' : first.data.cover)} alt="" data-p="img" width="500" height="300" />
          <img class="companion" src={url('/images/works/marugoto-fes/screen-03.webp')} alt="" width="1206" height="2622" />
        </a>
        <figcaption class="preview-foot">
          <a class="label jp" data-p="title" href={url(`works/${first.id}/`)} aria-live="polite">{first.data.title}</a>
          <span class="label meta" data-p="cat">{first.data.category}</span>
        </figcaption>
      </figure>
    )}
  </section>

  <section class="works wrap" aria-labelledby="works-title" data-build="4">
    <div class="works-head">
      <h2 id="works-title" class="label">[01] 制作したもの <span aria-hidden="true">--------+</span></h2>
      {featured.length > 0 && <span class="label meta">01 — {pad(featured.length)}</span>}
    </div>
    <hr class="rule" />
    {featured.length === 0 ? (
      <p class="jp empty">作品を準備中です</p>
    ) : (
      <ol class="work-list">
        {featured.map((w, i) => (
          <li>
            <a
              class="work-row"
              href={url(`works/${w.id}/`)}
              data-id={w.id}
              data-title={w.data.title}
              data-cat={w.data.category}
              data-img={url(w.data.cover)}
              data-href={url(`works/${w.id}/`)}
            >
              <span class="work-thumb"><img src={url(w.id === 'marugoto-fes' ? '/images/works/marugoto-fes/screen-01.webp' : w.data.cover)} alt="" loading="lazy" /></span>
              <span class="details">
                <span class="name">{w.data.title}</span>
                <span class="work-summary jp">{w.data.summary}</span><span class="meta">{w.data.category}</span>
              </span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
            <hr class="rule" />
          </li>
        ))}
      </ol>
    )}
    <p class="all-link jp"><a href={url('works/')}>すべての作品を見る <span class="mono">({all.length})</span>&nbsp;&nbsp;<span aria-hidden="true">↗</span></a></p>
  </section>

  <section id="about" class="about wrap" aria-labelledby="about-title" data-build="5">
    <h2 id="about-title" class="label">[02] 私について<pre class="ascii-small" aria-hidden="true">{String.raw`   .--------.
   |  o  o  |
   |   __   |
   +---++---+
   /|  ||  |\
  /_|__||__|_\ `}</pre></h2>
    <p class="jp about-lead">考えて、つくって、試してみる。<br />ひとつずつ形にして、使う人に届ける。</p>
    <div class="jp about-body">
      <p>アイデアを考えるところから、デザインや開発、実際に使える形にするところまで、一つひとつ手を動かして取り組んでいます。</p>
      <p>使う人の気持ちを想像しながら、まずは小さくつくって試す。そんな試行錯誤を大切にしています。ゲームやアプリ、ものづくりなど、興味のあることに幅広く挑戦しています。</p>
    </div>
    <ul class="skills label" aria-label="得意分野">
      <li>PRODUCT DESIGN</li><li>FRONTEND</li><li>PROTOTYPING</li>
    </ul>
  </section>

  <section id="contact" class="contact wrap" aria-labelledby="contact-title" data-build="6">
    <hr class="rule" />
    <div class="contact-grid">
      <div>
        <pre class="ascii-small" aria-hidden="true">{String.raw`  ___________________
 /__________________/|
 |  hello, world_   ||
 |__________________|/
      /________\ `}</pre><h2 id="contact-title" class="contact-title jp">一緒につくりませんか</h2>
        <p class="jp">制作のご相談・お問い合わせ</p>
        {hasContact ? (
          <ul class="contact-list label">
            {email && <li><a href={`mailto:${email}`}>EMAIL&nbsp;&nbsp;/&nbsp;&nbsp;{email}</a></li>}
            {github && <li><a href={github} rel="me noopener">GITHUB&nbsp;&nbsp;/&nbsp;&nbsp;{github.replace(/^https?:\/\//, '')}<span class="visually-hidden">（GitHub プロフィール、外部サイト）</span></a></li>}
            {x && <li><a href={x} rel="me noopener">X&nbsp;&nbsp;/&nbsp;&nbsp;{x.replace(/^https?:\/\/(www\.)?/, '')}<span class="visually-hidden">（X プロフィール、外部サイト）</span></a></li>}
          </ul>
        ) : (
          <p class="jp muted">連絡先は準備中です。</p>
        )}
      </div>
      {x && (
        <aside class="x-card" aria-label="Xの投稿プレビュー">
          <div class="x-head"><span aria-hidden="true" class="x-logo">𝕏</span><span class="label">Xでの発信</span></div>
          <div class="x-profile">
            <span class="x-avatar" aria-hidden="true">Y</span>
            <span class="x-identity"><strong>{xName}</strong><span class="label">@{x.split('/').filter(Boolean).pop()}</span></span>
            <a class="x-follow label" href={x} rel="me noopener">PROFILE ↗<span class="visually-hidden">（Xプロフィール、外部サイト）</span></a>
          </div>
          <a class="twitter-timeline" data-height="380" data-theme="dark" data-chrome="noheader nofooter noborders transparent" href={x}>@{x.split('/').filter(Boolean).pop()} のポストを読み込む</a>
          <noscript><a class="label" href={x}>Xで投稿を見る ↗</a></noscript>
        </aside>
      )}
    </div>
  </section>

  <BuildIntro slot="after" />
</Base>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; display: grid; width: 100%; max-width: none; margin: 0; min-height: calc(100svh - var(--header-height)); grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 64px; align-items: center; padding: 64px max(var(--gutter), calc((100vw - var(--max)) / 2)); background: var(--c-deep); }
  .hero-text, .preview { position: relative; z-index: 1; }
  .dreamscape { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .light-orbit { position: absolute; width: 100%; height: 140%; left: 50%; top: -20%; border: 1px solid #f2f3ff12; border-radius: 50%; transform: rotate(-25deg); }
  .hero-text { display: flex; flex-direction: column; gap: 32px; }
  .hero-text > .label { color: var(--c-secondary); font-size: .8125rem; }
  h1 { font-size: clamp(2.25rem, 4.1vw, 4rem); line-height: 1.5; margin: 0; font-weight: 500; letter-spacing: -.035em; }
  h1 span { display: block; white-space: nowrap; }
  .lead { font-size: 1.0625rem; margin: 0; color: var(--c-secondary); line-height: 2; }
  .hero-actions { display: flex; align-items: center; gap: 32px; font-size: .9375rem; }
  .hero-actions a { text-decoration: none; }
  .primary-link { display: flex; align-items: center; gap: 40px; min-height: 48px; padding: 12px 20px; background: var(--c-lime); color: #141246; border-radius: 4px; font-weight: 500; }
  .hero-actions a:hover { text-decoration: underline; }
  .preview { width: 100%; max-width: 672px; justify-self: end; margin: 0; background: var(--c-surface); border: 1px solid var(--c-line); border-radius: 0; overflow: hidden; }
  .preview-head, .preview-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 24px; flex-wrap: wrap; }
  .preview-head > .label { font-size: .75rem; color: var(--c-secondary); }
  .preview-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .preview-tabs button { font: 400 .75rem var(--f-jp); color: var(--c-secondary); background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 8px; min-height: 36px; cursor: pointer; transition: color .16s, background .16s; }
  .preview-tabs button:hover { background: #ffffff0c; color: var(--c-text); }
  .preview-tabs button[aria-pressed="true"]:not(.preview-pause) { background: #ffffff10; color: var(--c-lime); border-color: var(--c-line); }
  .preview-img { display: block; height: clamp(320px, 42vh, 480px); background: var(--c-deep); }
  .preview-img img { width: 100%; height: 100%; object-fit: contain; padding: 24px; transition: opacity .2s; }
  .preview-img .companion { display: none; }
  .preview[data-current="marugoto-fes"] .preview-img { display: flex; align-items: center; justify-content: center; gap: 16px; padding: 24px; }
  .preview[data-current="marugoto-fes"] .preview-img img { padding: 0; width: auto; max-width: 30%; height: 100%; object-fit: contain; }
  .preview[data-current="marugoto-fes"] .preview-img .companion { display: block; height: 88%; opacity: .8; }
  .preview-foot a { text-decoration: none; }
  .preview-foot a:hover { text-decoration: underline; }
  .preview-foot .label { font-size: .9375rem; }
  .preview-foot .meta { font-size: .6875rem; }
  .meta { color: var(--c-muted); font-weight: 400; font-size: .75rem; }
  .works, .about, .contact { padding-top: 112px; }
  .works-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 24px; }
  .works-head h2, .about > h2 { font-family: var(--f-jp); font-size: 1rem; font-weight: 500; }
  .work-list { list-style: none; margin: 0; padding: 0; }
  .work-row { display: grid; grid-template-columns: 160px minmax(0, 1fr) 24px; gap: 32px; align-items: center; padding: 32px 0; text-decoration: none; }
  .work-thumb { height: 112px; background: var(--c-surface); border-radius: 4px; overflow: hidden; }
  .work-thumb img { width: 100%; height: 100%; object-fit: contain; padding: 8px; }
  .work-row .details { display: flex; flex-direction: column; gap: 8px; }
  .work-row .name { font-family: var(--f-jp); font-weight: 500; font-size: 1.5rem; }
  .work-summary { font-size: .9375rem; color: var(--c-secondary); }
  .work-row:hover .name, .work-row:focus-visible .name, .work-row.is-active .name { color: var(--c-lime); }
  .arrow { color: var(--c-secondary); }
  .all-link { margin: 32px 0 0; font-weight: 400; font-size: 1rem; }
  .all-link a { color: var(--c-lime); }
  .empty { padding: 24px 0; }
  .about { display: grid; grid-template-columns: 1fr 2fr; gap: 24px 64px; }
  .about > h2 { grid-row: span 3; padding-top: 8px; }
  .about-lead { font-size: clamp(1.375rem, 2.4vw, 2rem); font-weight: 400; margin: 0; line-height: 1.8; }
  .about-body { max-width: 40em; font-size: 1rem; line-height: 2; color: var(--c-secondary); }
  .about-body p { margin: 0 0 16px; }
  .skills { display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; padding: 0; margin: 0; font-weight: 400; font-size: .6875rem; color: var(--c-muted); }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 440px); align-items: start; gap: 64px; padding-top: 48px; }
  .contact-title { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 400; margin: 0 0 16px; }
  .contact-grid > div > p { font-size: .9375rem; color: var(--c-secondary); }
  .contact-list { list-style: none; padding: 0; margin: 32px 0 0; display: flex; flex-direction: column; gap: 16px; font-size: .875rem; font-weight: 400; overflow-wrap: anywhere; }
  .contact-list a { text-decoration: none; }
  .contact-list a:hover { text-decoration: underline; }
  .muted { color: var(--c-muted); }
  .x-card { min-width: 0; background: var(--c-surface); border: 1px solid var(--c-line); border-radius: 8px; padding: 24px; display: flex; flex-direction: column; gap: 16px; width: 100%; }
  .x-head { display: flex; justify-content: space-between; align-items: center; }
  .x-head .label { font-family: var(--f-jp); font-size: .75rem; color: var(--c-muted); }
  .x-logo { font-size: 1.25rem; }
  .x-profile { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .x-avatar { display: grid; place-items: center; flex: 0 0 40px; width: 40px; height: 40px; border-radius: 50%; background: #ffffff10; font-size: 1rem; }
  .x-identity { display: flex; flex-direction: column; min-width: 0; gap: 4px; }
  .x-identity strong { font-size: .9375rem; font-weight: 500; }
  .x-identity .label { font-size: .6875rem; color: var(--c-secondary); }
  .x-follow { margin-left: auto; white-space: nowrap; text-decoration: none; font-size: .6875rem; }
  .x-follow:hover { text-decoration: underline; }
  .twitter-timeline { color: var(--c-secondary); font-size: .875rem; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; align-content: center; gap: 40px; padding-block: 48px; }
    .hero-text { gap: 24px; }
    h1 { font-size: clamp(2rem, 5.6vw, 3.5rem); }
    .preview { justify-self: start; max-width: 672px; }
    .preview-img { height: 360px; }
    .about { grid-template-columns: 1fr; gap: 24px; }
    .about > h2 { grid-row: auto; }
    .contact-grid { grid-template-columns: 1fr; gap: 40px; }
    .x-card { max-width: 560px; }
    .works, .about, .contact { padding-top: 80px; }
  }
  @media (max-width: 480px) {
    .work-row { grid-template-columns: 80px minmax(0, 1fr) 16px; gap: 16px; padding-block: 24px; }
    .work-thumb { height: 88px; }
    .work-row .name { font-size: 1.125rem; }
    .work-summary { font-size: .8125rem; }
    .preview-head, .preview-foot { padding: 16px; }
    .preview-tabs { gap: 4px; }
    .preview-img { height: 320px; }
    .preview-foot .meta { display: none; }
  }

  .ascii-logo { font: 400 clamp(10px, 1.25vw, 18px)/1.2 var(--f-mono); color: var(--c-lime); margin: 0; white-space: pre; }
  .ascii-terrain { position: absolute; z-index: -1; inset: auto -4% -2%; margin: 0; font: 400 clamp(8px, 1.4vw, 22px)/1.1 var(--f-mono); color: var(--c-sky); opacity: .18; white-space: pre; pointer-events: none; }
  .terminal-line { color: var(--c-sky) !important; }
  .hero { gap: 48px; }
  .hero-text { gap: 24px; }
  h1 { font-size: clamp(1.875rem, 3.1vw, 3rem); line-height: 1.6; }
  .preview { border-style: dashed; background: var(--c-surface); }
  .ascii-toolbar { display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; border-bottom: 1px dashed var(--c-line); color: var(--c-sky); font-size: .75rem; gap: 12px; }
  .view-toggle { color: var(--c-lime); background: none; border: 0; padding: 8px 0; cursor: pointer; font: 400 .75rem var(--f-jp); text-decoration: underline; text-underline-offset: 4px; }
  .ascii-output { height: clamp(320px, 42vh, 480px); display: grid; align-items: center; justify-items: center; overflow: hidden; background: var(--c-deep); padding: 16px; }
  .ascii-output pre { margin: 0; color: var(--c-lime); font: 400 clamp(3px, .55vw, 7px)/1.2 var(--f-mono); letter-spacing: 0; white-space: pre; }
  .preview[data-view="ascii"] .preview-img { display: none; }
  .preview[data-view="image"] .ascii-output { display: none; }
  .ascii-small { color: var(--c-sky); font: 400 .875rem/1.2 var(--f-mono); margin: 32px 0; white-space: pre; }
  .works-head h2 span { color: var(--c-sky); }
  .work-row::after { content: '[open]'; font: 400 .6875rem var(--f-mono); color: var(--c-lime); }
  .work-row { grid-template-columns: 160px minmax(0, 1fr) 48px; }
  .work-row .arrow { display: none; }
  @media (max-width: 860px) { .ascii-output pre { font-size: clamp(3px, 1vw, 7px); } .ascii-logo { font-size: 14px; } }
  @media (max-width: 480px) { .works-head h2 span { display: none; } .work-row { grid-template-columns: 72px minmax(0,1fr) 36px; gap: 12px; } .ascii-toolbar { padding-inline: 16px; } }
</style>

<script is:inline async src="https://platform.x.com/widgets.js" charset="utf-8"></script>

<script>
  type P = { id: string; no: string; title: string; cat: string; img: string; href: string };
  const preview = document.querySelector<HTMLElement>('.preview');
  const poolEl = document.getElementById('preview-pool');
  if (preview && poolEl) {
    const pool: P[] = JSON.parse(poolEl.textContent || '[]');
    const rows = [...document.querySelectorAll<HTMLAnchorElement>('.work-row')];
    const tabs = [...preview.querySelectorAll<HTMLButtonElement>('[data-select]')];
    const pauseBtn = preview.querySelector<HTMLButtonElement>('.preview-pause');
    const q = (k: string) => preview.querySelector<HTMLElement>(`[data-p="${k}"]`)!;
    const img = q('img') as HTMLImageElement;
    const output = preview.querySelector<HTMLElement>('[data-ascii]')!;
    const toggle = preview.querySelector<HTMLButtonElement>('.view-toggle')!;
    const renderAscii = () => {
      if (!img.complete || !img.naturalWidth) return;
      const canvas = document.createElement('canvas'); canvas.width = 120; canvas.height = 44;
      const ctx = canvas.getContext('2d', { willReadFrequently: true }); if (!ctx) return;
      ctx.fillStyle = '#090e19'; ctx.fillRect(0, 0, 120, 44);
      const sources = preview.dataset.current === 'marugoto-fes' ? [...preview.querySelectorAll<HTMLImageElement>('.preview-img img')] : [img];
      try {
        sources.forEach((source, i) => {
          if (!source.complete || !source.naturalWidth) return;
          const area = 120 / sources.length, ratio = source.naturalWidth / source.naturalHeight;
          const h = Math.min(40, (area - 6) / ratio / 2), w = h * ratio * 2;
          ctx.drawImage(source, i * area + (area - w) / 2, (44 - h) / 2, w, h);
        });
        const pixels = ctx.getImageData(0, 0, 120, 44).data, chars = ' .,:;irsXA253hMHGS#9B&@';
        let result = '';
        for (let y = 0; y < 44; y++) {
          for (let x = 0; x < 120; x++) {
            const i = (y * 120 + x) * 4;
            const light = pixels[i] * .2126 + pixels[i+1] * .7152 + pixels[i+2] * .0722;
            result += chars[Math.min(chars.length-1, Math.floor(light / 256 * chars.length))];
          }
          result += '\n';
        }
        output.textContent = result;
      } catch { preview.dataset.view = 'image'; toggle.hidden = true; }
    };
    preview.querySelectorAll('img').forEach((source) => source.addEventListener('load', renderAscii));
    renderAscii();
    toggle.addEventListener('click', () => {
      const ascii = preview.dataset.view !== 'ascii'; preview.dataset.view = ascii ? 'ascii' : 'image';
      toggle.setAttribute('aria-pressed', String(ascii)); toggle.textContent = ascii ? '実画面に切り替え' : 'ASCIIに切り替え';
    });
    const INTERVAL = 4500;
    let current = pool.find((p) => p.title === q('title').textContent)?.id ?? pool[0]?.id;
    let userPaused = true, hold = false, timer = 0;

    const show = (id: string) => {
      const p = pool.find((x) => x.id === id);
      if (!p) return;
      current = id;
      preview.dataset.current = id;
      const apply = () => {
        q('num').textContent = p.no;
        q('title').textContent = p.title;
        (q('title') as HTMLAnchorElement).href = p.href;
        q('cat').textContent = p.cat;
        (q('link') as HTMLAnchorElement).href = p.href;
        img.src = p.img;
        img.style.opacity = '1';
      };
      if (img.getAttribute('src') === p.img) apply();
      else { img.style.opacity = '0'; setTimeout(apply, 180); }
      rows.forEach((r) => r.classList.toggle('is-active', r.dataset.id === id));
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.select === id)));
    };
    const next = () => {
      const others = pool.filter((p) => p.id !== current && ['marugoto-fes', 'paperbrowser', 'tokarium'].includes(p.id));
      if (others.length) show(others[Math.floor(Math.random() * others.length)].id);
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const schedule = () => {
      clearInterval(timer);
      if (!userPaused && !hold && !reduce && pool.length > 1) timer = window.setInterval(() => { if (!document.hidden) next(); }, INTERVAL);
    };
    const setPaused = (v: boolean) => {
      userPaused = v;
      if (pauseBtn) {
        pauseBtn.setAttribute('aria-pressed', String(v));
        pauseBtn.setAttribute('aria-label', v ? '自動切り替えを再開' : '自動切り替えを停止');
        pauseBtn.textContent = v ? '再生' : '一時停止';
      }
      schedule();
    };
    setPaused(true);

    rows.forEach((r) => {
      const enter = () => { hold = true; show(r.dataset.id!); schedule(); };
      const leave = () => { hold = false; schedule(); };
      r.addEventListener('mouseenter', enter); r.addEventListener('focus', enter);
      r.addEventListener('mouseleave', leave); r.addEventListener('blur', leave);
    });
    preview.addEventListener('mouseenter', () => { hold = true; schedule(); });
    preview.addEventListener('mouseleave', () => { hold = false; schedule(); });
    tabs.forEach((t) => t.addEventListener('click', () => { show(t.dataset.select!); setPaused(true); }));
    pauseBtn?.addEventListener('click', () => { if (userPaused) next(); setPaused(!userPaused); });
    // 先読み
    pool.forEach((p) => { const im = new Image(); im.src = p.img; });
    schedule();
  }
</script>
