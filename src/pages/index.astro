---
import Base from '../layouts/Base.astro';
import BuildIntro from '../components/BuildIntro.astro';
import { getPublishedWorks, getFeaturedWorks, url } from '../lib/works';
import { site } from '../data/site';

const all = await getPublishedWorks();
const featured = await getFeaturedWorks();
const pad = (n: number) => String(n).padStart(2, '0');
const first = featured[0] ?? all[0];
// ヒーローのプレビューは公開作品すべてからランダムに切り替える
const pool = all.map((w, i) => ({ id: w.id, no: pad(i + 1), title: w.data.title, cat: w.data.category, img: url(w.data.cover), href: url(`works/${w.id}/`) }));
const firstNo = pad(all.findIndex((w) => w.id === first?.id) + 1);
const { email, github, x, xName } = site.contact;
const hasContact = Boolean(email || github || x);
---
<Base intro current="home">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-text" data-build="2">
      <p class="label">DESIGN&nbsp;&nbsp;×&nbsp;&nbsp;CODE&nbsp;&nbsp;×&nbsp;&nbsp;CURIOSITY</p>
      <h1 id="hero-title" class="jp" data-type><span>アイデアを、</span><span>動くかたちに。</span></h1>
      <p class="jp lead">デザインと開発を行き来しながら、<br />人や暮らしに届く体験をつくっています。</p>
    </div>

    {first && (
      <figure class="preview" data-build="3" data-draw aria-label="作品プレビュー（一定時間ごとに切り替わります）">
        <script type="application/json" id="preview-pool" set:html={JSON.stringify(pool)} />
        <div class="preview-head">
          <span class="label"><span data-p="num">{firstNo}</span>&nbsp;&nbsp;/&nbsp;&nbsp;WORKS</span>
          <div class="preview-tabs" role="group" aria-label="プレビューの操作">
            {featured.length > 1 && featured.map((w, i) => (
              <button type="button" data-select={w.id} aria-pressed={w.id === first.id ? 'true' : 'false'} aria-label={`${w.data.title} をプレビュー`}>{pad(i + 1)}</button>
            ))}
            {pool.length > 1 && (
              <button type="button" class="preview-pause" aria-pressed="false" aria-label="自動切り替えを停止">❚❚</button>
            )}
          </div>
        </div>
        <a class="preview-img" href={url(`works/${first.id}/`)} data-p="link" tabindex="-1" aria-hidden="true">
          <img src={url(first.data.cover)} alt="" data-p="img" width="500" height="300" />
        </a>
        <figcaption class="preview-foot">
          <span class="label" data-p="title" aria-live="polite">{first.data.title}</span>
          <span class="label meta" data-p="cat">{first.data.category}</span>
        </figcaption>
      </figure>
    )}
  </section>

  <section class="works wrap" aria-labelledby="works-title" data-build="4">
    <div class="works-head">
      <h2 id="works-title" class="label">SELECTED WORKS</h2>
      {featured.length > 0 && <span class="label meta">01 — {pad(featured.length)}</span>}
    </div>
    <hr class="rule" />
    {featured.length === 0 ? (
      <p class="jp empty">作品を準備中です</p>
    ) : (
      <ol class="work-list">
        {featured.map((w, i) => (
          <li>
            <a
              class="work-row"
              href={url(`works/${w.id}/`)}
              data-id={w.id}
              data-title={w.data.title}
              data-cat={w.data.category}
              data-img={url(w.data.cover)}
              data-href={url(`works/${w.id}/`)}
            >
              <span class="num">{pad(i + 1)}</span>
              <span class="details">
                <span class="name">{w.data.title}</span>
                <span class="meta">{w.data.category}</span>
              </span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
            <hr class="rule" />
          </li>
        ))}
      </ol>
    )}
    <p class="all-link jp"><a href={url('works/')}>すべての作品を見る <span class="mono">({all.length})</span>&nbsp;&nbsp;<span aria-hidden="true">↗</span></a></p>
  </section>

  <section id="about" class="about wrap" aria-labelledby="about-title" data-build="5">
    <h2 id="about-title" class="label">A LITTLE ABOUT ME</h2>
    <p class="jp about-lead">考えて、つくって、試してみる。<br />ひとつずつ形にして、使う人に届ける。</p>
    <div class="jp about-body">
      <p>アイデアを考えるところから、デザインや開発、実際に使える形にするところまで、一つひとつ手を動かして取り組んでいます。</p>
      <p>使う人の気持ちを想像しながら、まずは小さくつくって試す。そんな試行錯誤を大切にしています。ゲームやアプリ、ものづくりなど、興味のあることに幅広く挑戦しています。</p>
    </div>
    <ul class="skills label" aria-label="得意分野">
      <li>PRODUCT DESIGN</li><li>FRONTEND</li><li>PROTOTYPING</li>
    </ul>
  </section>

  <section id="contact" class="contact wrap" aria-labelledby="contact-title" data-build="6">
    <hr class="rule" />
    <div class="contact-grid">
      <div>
        <h2 id="contact-title" class="contact-title">CONTACT</h2>
        <p class="jp">制作のご相談・お問い合わせ</p>
        {hasContact ? (
          <ul class="contact-list label">
            {email && <li><a href={`mailto:${email}`}>EMAIL&nbsp;&nbsp;/&nbsp;&nbsp;{email}</a></li>}
            {github && <li><a href={github} rel="me noopener">GITHUB&nbsp;&nbsp;/&nbsp;&nbsp;{github.replace(/^https?:\/\//, '')}<span class="visually-hidden">（GitHub プロフィール、外部サイト）</span></a></li>}
            {x && <li><a href={x} rel="me noopener">X&nbsp;&nbsp;/&nbsp;&nbsp;{x.replace(/^https?:\/\/(www\.)?/, '')}<span class="visually-hidden">（X プロフィール、外部サイト）</span></a></li>}
          </ul>
        ) : (
          <p class="jp muted">連絡先は準備中です。</p>
        )}
      </div>
      {x && (
        <aside class="x-card" aria-label="Xの投稿プレビュー">
          <div class="x-head"><span aria-hidden="true" class="x-logo">𝕏</span><span class="label">LATEST POSTS</span></div>
          <div class="x-profile">
            <span class="x-avatar" aria-hidden="true">Y</span>
            <span class="x-identity"><strong>{xName}</strong><span class="label">@{x.split('/').filter(Boolean).pop()}</span></span>
            <a class="x-follow label" href={x} rel="me noopener">PROFILE ↗<span class="visually-hidden">（Xプロフィール、外部サイト）</span></a>
          </div>
          <a class="twitter-timeline" data-height="380" data-theme="dark" data-chrome="noheader nofooter noborders transparent" href={x}>@{x.split('/').filter(Boolean).pop()} のポストを読み込む</a>
          <noscript><a class="label" href={x}>Xで投稿を見る ↗</a></noscript>
        </aside>
      )}
    </div>
  </section>

  <BuildIntro slot="after" />
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    width: 100vw;
    max-width: none;
    margin: 0 0 0 calc(50% - 50vw);
    min-height: calc(100svh - 90px);
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    gap: clamp(32px, 5vw, 76px);
    align-items: center;
    padding: clamp(48px, 6vw, 88px) max(var(--gutter), calc((100vw - var(--max)) / 2));
    background: var(--c-blue);
  }
  h1 span { display: block; white-space: nowrap; }
  .hero-text { display: flex; flex-direction: column; gap: clamp(20px, 2.4vw, 34px); }
  h1 { font-size: clamp(2.6rem, 5.6vw, 5.5rem); line-height: 1.22; margin: 0; font-weight: 700; letter-spacing: -.035em; }
  .lead { font-size: clamp(1rem, 1.4vw, 1.1875rem); margin: 0; line-height: 1.9; }

  .preview { width: 100%; max-width: 700px; justify-self: end; margin: 0; background: var(--c-deep); }
  .preview-head, .preview-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 20px; flex-wrap: wrap; }
  .preview-tabs { display: flex; gap: 4px; }
  .preview-tabs button {
    font: 700 0.8125rem var(--f-mono); color: var(--c-lime); background: transparent;
    border: 1px solid color-mix(in srgb, var(--c-lime) 50%, transparent); padding: 6px 10px; min-width: 40px; min-height: 32px; cursor: pointer;
  }
  .preview-pause { font-size: .625rem !important; letter-spacing: -.1em; }
  .preview-tabs button[aria-pressed="true"]:not(.preview-pause) { background: var(--c-lime); color: var(--c-blue); }
  .preview-img { display: block; aspect-ratio: 500 / 290; background: var(--c-deep); }
  .preview-img img { width: 100%; height: 100%; object-fit: contain; padding: 16px; transition: opacity .2s; }
  .meta { font-weight: 400; }

  .works { padding-top: clamp(72px, 9vw, 120px); }
  .works-head { display: flex; justify-content: space-between; padding-bottom: 15px; }
  .work-list { list-style: none; margin: 0; padding: 0; }
  .work-row { display: grid; grid-template-columns: auto 1fr auto; gap: 17px; align-items: start; padding: 15px 0; text-decoration: none; }
  .work-row .num { font-weight: 700; padding-top: 4px; }
  .work-row .details { display: flex; flex-direction: column; gap: 4px; }
  .work-row .name { font-weight: 700; font-size: 1.3125rem; }
  .work-row:hover .name, .work-row:focus-visible .name, .work-row.is-active .name { text-decoration: underline; text-underline-offset: 0.2em; }
  .work-row .arrow { transition: transform .2s; }
  .work-row:hover .arrow { transform: translate(3px, -3px); }
  .all-link { margin: 28px 0 0; font-weight: 700; font-size: 1.125rem; }
  .all-link a { text-decoration: none; }
  .all-link a:hover { text-decoration: underline; }
  .empty { padding: 24px 0; }

  .about { padding-top: clamp(80px, 10vw, 140px); display: flex; flex-direction: column; gap: 18px; }
  .about-lead { font-size: 1.3125rem; font-weight: 700; margin: 0; line-height: 1.7; }
  .about-body { max-width: 50em; font-size: 1.0625rem; line-height: 1.9; }
  .about-body p { margin: 0 0 1em; }
  .skills { display: flex; flex-wrap: wrap; gap: 8px 28px; list-style: none; padding: 0; margin: 0; font-weight: 400; }

  .contact { padding-top: clamp(80px, 10vw, 140px); }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 475px); align-items: start; gap: clamp(32px, 7vw, 96px); padding-top: 24px; }
  .contact-title { font: 700 1.875rem var(--f-mono); margin: 0 0 8px; }
  .contact-list { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 10px; }
  .contact-list a { text-decoration: none; }
  .contact-list a:hover { text-decoration: underline; }
  .muted { opacity: .85; }
  .x-card { min-width: 0; background: var(--c-blue); padding: 20px; display: flex; flex-direction: column; gap: 14px; width: 100%; }
  .x-head { display: flex; justify-content: space-between; align-items: center; }
  .x-logo { font-size: 1.5rem; font-weight: 700; }
  .x-profile { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .x-avatar { display: grid; place-items: center; flex: 0 0 42px; width: 42px; height: 42px; border-radius: 50%; background: var(--c-lime); color: var(--c-blue); font: 700 1.1rem var(--f-mono); }
  .x-identity { display: flex; flex-direction: column; min-width: 0; gap: 2px; }
  .x-identity strong { font-size: 1rem; }
  .x-identity .label { opacity: .82; }
  .x-follow { margin-left: auto; white-space: nowrap; text-decoration: none; }
  .x-follow:hover { text-decoration: underline; }
  .twitter-timeline { color: var(--c-lime); }

  @media (max-width: 860px) {
    .hero { min-height: calc(100svh - 76px); grid-template-columns: 1fr; grid-template-rows: auto auto; align-content: center; gap: 44px; padding-top: 56px; padding-bottom: 52px; }
    .hero-text { gap: 22px; }
    h1 { font-size: clamp(2.6rem, 8vw, 4.25rem); }
    .preview { justify-self: start; max-width: 640px; }
    .contact-grid { grid-template-columns: 1fr; }
    .x-card { max-width: 560px; }
  }
</style>

<script is:inline async src="https://platform.x.com/widgets.js" charset="utf-8"></script>

<script>
  type P = { id: string; no: string; title: string; cat: string; img: string; href: string };
  const preview = document.querySelector<HTMLElement>('.preview');
  const poolEl = document.getElementById('preview-pool');
  if (preview && poolEl) {
    const pool: P[] = JSON.parse(poolEl.textContent || '[]');
    const rows = [...document.querySelectorAll<HTMLAnchorElement>('.work-row')];
    const tabs = [...preview.querySelectorAll<HTMLButtonElement>('[data-select]')];
    const pauseBtn = preview.querySelector<HTMLButtonElement>('.preview-pause');
    const q = (k: string) => preview.querySelector<HTMLElement>(`[data-p="${k}"]`)!;
    const img = q('img') as HTMLImageElement;
    const INTERVAL = 4500;
    let current = pool.find((p) => p.title === q('title').textContent)?.id ?? pool[0]?.id;
    let userPaused = false, hold = false, timer = 0;

    const show = (id: string) => {
      const p = pool.find((x) => x.id === id);
      if (!p) return;
      current = id;
      const apply = () => {
        q('num').textContent = p.no;
        q('title').textContent = p.title;
        q('cat').textContent = p.cat;
        (q('link') as HTMLAnchorElement).href = p.href;
        img.src = p.img;
        img.style.opacity = '1';
      };
      if (img.getAttribute('src') === p.img) apply();
      else { img.style.opacity = '0'; setTimeout(apply, 180); }
      rows.forEach((r) => r.classList.toggle('is-active', r.dataset.id === id));
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.select === id)));
    };
    const next = () => {
      const others = pool.filter((p) => p.id !== current);
      if (others.length) show(others[Math.floor(Math.random() * others.length)].id);
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const schedule = () => {
      clearInterval(timer);
      if (!userPaused && !hold && !reduce && pool.length > 1) timer = window.setInterval(() => { if (!document.hidden) next(); }, INTERVAL);
    };
    const setPaused = (v: boolean) => {
      userPaused = v;
      if (pauseBtn) {
        pauseBtn.setAttribute('aria-pressed', String(v));
        pauseBtn.setAttribute('aria-label', v ? '自動切り替えを再開' : '自動切り替えを停止');
        pauseBtn.textContent = v ? '▶' : '❚❚';
      }
      schedule();
    };
    if (reduce) setPaused(true);

    rows.forEach((r) => {
      const enter = () => { hold = true; show(r.dataset.id!); schedule(); };
      const leave = () => { hold = false; schedule(); };
      r.addEventListener('mouseenter', enter); r.addEventListener('focus', enter);
      r.addEventListener('mouseleave', leave); r.addEventListener('blur', leave);
    });
    preview.addEventListener('mouseenter', () => { hold = true; schedule(); });
    preview.addEventListener('mouseleave', () => { hold = false; schedule(); });
    tabs.forEach((t) => t.addEventListener('click', () => { show(t.dataset.select!); setPaused(true); }));
    pauseBtn?.addEventListener('click', () => { if (userPaused) next(); setPaused(!userPaused); });
    // 先読み
    pool.forEach((p) => { const im = new Image(); im.src = p.img; });
    schedule();
  }
</script>
