---
import Base from '../layouts/Base.astro';
import { url } from '../lib/works';
---
<Base title="ページが見つかりません" description="お探しのページは見つかりませんでした。">
  <div class="wrap nf">
    <p class="label">ERROR / 404</p>
    <h1>NOT FOUND</h1>
    <p class="jp">お探しのページは見つかりませんでした。URL が変更されたか、削除された可能性があります。</p>
    <p class="label links"><a href={url()}>← HOME</a><a href={url('works/')}>WORKS ↗</a></p>
  </div>
</Base>
<style>
  .nf { padding-top: clamp(72px, 12vw, 160px); display: flex; flex-direction: column; gap: 16px; }
  .nf p { margin: 0; }
  h1 { font: 700 clamp(3rem, 8vw, 5rem)/1.1 var(--f-mono); margin: 0; }
  .links { display: flex; gap: 32px; padding-top: 16px; }
  .links a { text-decoration: none; }
  .links a:hover { text-decoration: underline; }
</style>
